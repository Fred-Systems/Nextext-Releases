rules_version = '2';

// v1.6.14: requester may create a pending doc in the recipient's contacts
// subcollection (see match /users/{uid}/contacts/{contactUid} allow create).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function notBanned() {
      let m = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.moderation;
      return m == null || m.banType == 'none';
    }
    function isChatParticipant(chatId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }
    // True when the signed-in user is a group admin: the group's creator or
    // listed in its groupAdmins array. Used to gate admin-management writes.
    function isGroupAdmin(chatId) {
      let data = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return isSignedIn() && (
        request.auth.uid == data.createdBy ||
        (data.groupAdmins != null && request.auth.uid in data.groupAdmins)
      );
    }
    // Daily message send limit — checks a per-user rolling-window counter doc
    // at messageLimits/{uid}. The client increments `count` and resets
    // `windowStart` as part of sending each message (see messageLimits rule
    // below). This blunts scripted abuse/runaway sends, not normal chatting —
    // default cap here is generous (500/24h). Note: like the app's other
    // client-reported counters (data usage, time limits), this relies on the
    // client to update the counter honestly; it's a deterrent for a trusted
    // friends-and-family app, not a cryptographically enforced hard limit.
    function underDailyMessageLimit() {
      let limitDoc = /databases/$(database)/documents/messageLimits/$(request.auth.uid);
      return !exists(limitDoc) ||
        (request.time - get(limitDoc).data.windowStart > duration.value(24, 'h')) ||
        get(limitDoc).data.count < 500;
    }

    // Enforces the real time windows for editing (15 min) and delete-for-
    // everyone (60 hours) server-side -- the UI hides these options once
    // expired, but this is what actually prevents a modified client from
    // bypassing that and editing/deleting old messages anyway.
    function withinEditDeleteWindows() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let editingText = changedKeys.hasAny(['text', 'editedAt', 'editHistory']);
      let deletingEveryone = changedKeys.hasAny(['deletedForEveryone']) &&
        request.resource.data.deletedForEveryone == true;
      let withinEditWindow = request.time < resource.data.sentAt + duration.value(15, 'm');
      let withinDeleteWindow = request.time < resource.data.sentAt + duration.value(60, 'h');
      return (!editingText || withinEditWindow) && (!deletingEveryone || withinDeleteWindow);
    }

    // Parental controls: checks the SENDER's own restrictions doc. If the
    // sender isn't a restricted child account, restrictions is null and
    // everything is allowed by default.
    function myRestrictions() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.restrictions;
    }
    function mediaAllowed(msgType) {
      let r = myRestrictions();
      // blockMedia is the legacy "block all media" flag; it must cover voice
      // notes too (it previously only blocked image/video, letting voice slip
      // through on accounts set up with the old field).
      return r == null ||
        !(((r.blockMedia == true || r.blockIncomingPhotos == true) && msgType == 'image') ||
          ((r.blockMedia == true || r.blockIncomingVideos == true) && msgType == 'video') ||
          ((r.blockMedia == true || r.blockVoiceNotes == true) && msgType == 'voice'));
    }
    function groupsAllowedFor(uid) {
      let r = get(/databases/$(database)/documents/users/$(uid)).data.restrictions;
      return r == null || r.blockGroups != true;
    }
    function statusAllowed() {
      let r = myRestrictions();
      return r == null || r.blockStatus != true;
    }

    // ── users ──────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn(); // profile fields are semi-public to any signed-in user;
                                     // sensitive fields (restrictions, moderation) are only
                                     // meaningfully USED by rules elsewhere, not exposed via UI
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin(); // admin can delete user docs (e.g. cleanup)

      match /contacts/{contactUid} {
        allow read: if isSelf(uid) || isSelf(contactUid);

        // The owner (uid) can freely manage their own contacts doc: nickname,
        // favorite, muted, blocked, accepting a request, etc.
        allow write: if isSelf(uid);

        // A contact REQUEST lets the requester (contactUid) write a "pending"
        // doc into the RECIPIENT's (uid's) contacts subcollection so the
        // recipient sees the incoming request. Allow the requester to create
        // that pending doc, and to update/delete it while it stays pending
        // (covers cancelling a request and re-sending). Accepting
        // (pending -> accepted) is performed by the owner (uid) via the rule
        // above, so the requester can never flip a request to "accepted".
        allow create: if request.auth.uid != null && request.resource.data.status == 'pending';
        // The requester (contactUid) may re-send, cancel, or delete their own
        // pending request at any time — including after it was previously
        // declined — so the update/delete guard does not require the existing
        // doc to still be "pending". (Accepting is performed only by the owner
        // via the isSelf(uid) write rule above, so a requester can never flip a
        // request to "accepted".)
        allow update, delete: if isSelf(contactUid);
      }

      // Lightweight per-device history (admin "Device History"). The owner writes
      // their own device records (merge, on session start / meaningful change);
      // the owner and admins may read them. No media is stored here.
      match /devices/{deviceId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(uid);
        allow delete: if isAdmin();
      }
    }

    // ── chats ──────────────────────────────────────────────
    match /chats/{chatId} {
      // FIX: reading a chat that doesn't exist yet must succeed (returning
      // "not found" to the client) rather than error out. Using the built-in
      // `resource` variable (the doc this rule is actually guarding) with a
      // null-check does this correctly. The earlier version called get() on
      // this same path from inside a helper function — Firestore throws when
      // get()'ing a nonexistent document, which surfaced as permission-denied
      // and silently broke first-time chat creation.
      allow read: if isSignedIn() && (isAdmin() ||
        (resource == null || request.auth.uid in resource.data.participants));
      allow create: if isSignedIn() && notBanned() &&
        request.auth.uid in request.resource.data.participants &&
        // Group-block check: Firestore rules can't loop over an arbitrary
        // array to check every invited member's restrictions doc, so this
        // enforces the rule for the CREATOR only (can't start a group if
        // they themselves are blocked from groups). Checking every invited
        // member the same way would need a Cloud Function trigger — not
        // implemented here; for now that half relies on the invite UI only
        // offering non-restricted contacts, same honest caveat as other
        // client-reported/client-enforced limits in this app.
        (request.resource.data.type != 'group' || groupsAllowedFor(request.auth.uid));
      allow update: if isSignedIn() && notBanned() &&
        request.auth.uid in resource.data.participants &&
        // Admin-management writes (groupAdmins) require the updater to be the
        // group creator or an existing group admin — otherwise any member
        // could self-promote or demote others.
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupAdmins']) ||
         isGroupAdmin(chatId));
      allow delete: if isSignedIn() && notBanned() &&
        request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        // Admins can read any chat's messages — needed for the per-user
        // statistics view, since count queries respect the same read rules.
        allow read: if isChatParticipant(chatId) || isAdmin();
        allow create: if isChatParticipant(chatId) && notBanned() && underDailyMessageLimit() &&
          (request.resource.data.senderId == request.auth.uid ||
           request.resource.data.senderId == 'nextext-ai-system' ||
           request.resource.data.recipientId == 'nextext-ai-system' ||
           request.resource.data.type == 'group') &&
          mediaAllowed(request.resource.data.type);
        // Note: any participant can write the whole `poll` object (needed so
        // votes can be cast by non-senders), which means a participant could
        // in principle overwrite others' votes too — same trust-model
        // tradeoff as other client-reported fields in this app (data usage,
        // time limits). Not a concern for a friends-and-family deployment;
        // would need per-key map validation or a Cloud Function to fully close.
        allow update: if isChatParticipant(chatId) && (
          (resource.data.senderId == request.auth.uid && withinEditDeleteWindows()) ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'readBy', 'deliveredTo', 'deletedForSelf', 'poll',
                      // forwarded-count is bumped by any participant when the
                      // message gets forwarded to another chat
                      'forwardedCount',
                      // voice-note transcription (additive — any participant can
                      // transcribe a note they can hear)
                      'transcript',
                      // message translation (additive — any participant can
                      // translate a message they can read; persisted so it
                      // survives leaving/reopening the chat)
                      'translatedText', 'translatedLang',
                       // live-location coordinates can be refreshed by any
                       // participant while the share is active
                       'lat', 'lng', 'accuracy', 'liveUntil',
                       // media blur placeholder (image) is scrubbed to null by
                       // the recipient once the media is downloaded + purged
                       'metadata'])
        );
        allow delete: if isChatParticipant(chatId);
      }
    }

    // ── message rate-limit counters (client-updated, self-only) ──
    match /messageLimits/{uid} {
      allow read: if isSelf(uid);
      allow write: if isSelf(uid);
    }

    // ── daily usage counters (media bytes + status count, client-updated, self-only) ──
    // Previously missing: status/media limit checks read/write usage/{uid}, which
    // default-denied and surfaced as "Missing or insufficient permissions" on
    // every status post (and media-limit check).
    match /usage/{uid} {
      allow read: if isSelf(uid);
      allow write: if isSelf(uid);
    }

    // ── status ─────────────────────────────────────────────
    // Status visibility is INDEPENDENT from online/presence visibility. A status
    // is hidden from a viewer if they appear in either (a) the poster's global
    // privacy.statusExcluded list, or (b) this status's per-status excludedUids
    // list. Both are enforced here (access layer), not just hidden in the UI.
    function statusExcludedFor(viewer) {
      let owner = get(/databases/$(database)/documents/users/$(resource.data.ownerId));
      let priv = owner.data.privacy;
      let globalExcluded = (priv != null && priv.statusExcluded != null) ? priv.statusExcluded : [];
      let perStatus = (resource.data.excludedUids != null) ? resource.data.excludedUids : [];
      return globalExcluded.hasAny([viewer]) || perStatus.hasAny([viewer]);
    }
    // Administrative moderation override: an authorized admin may read ANY status
    // (regardless of visibility / exclusions) only when the global
    // allowAdminStatusAccess setting is enabled. Enforced server-side, not just UI.
    function adminCanAccessStatus() {
      return isAdmin()
        && get(/databases/$(database)/documents/config/globalSettings).data.allowAdminStatusAccess == true;
    }
    match /status/{statusId} {
      // NOTE: the read rule must stay PROVABLE for queries (e.g.
      // where("visibility","==","public")). statusExcludedFor() calls
      // get(/users/$(resource.data.ownerId)), a path derived from per-document
      // data — Firestore cannot prove such a query returns only readable docs,
      // so it DENIES the entire query and public statuses never appear. We
      // therefore enforce only per-status `excludedUids` (provable from
      // resource.data) at the server layer; the owner's global statusExcluded
      // list is enforced client-side (same trust model as other client-enforced
      // limits in this app). This restores public-status visibility.
      // NOTE: the read rule MUST stay PROVABLE for Firestore queries.
      //   • where("allowedUids","array-contains", viewer)
      //   • where("visibility","==","public")
      // A previous version added `&& !(excludedUids.hasAny(viewer))` to each
      // branch. Because excludedUids is NOT part of either query predicate,
      // Firestore could not prove the queries only return readable docs and
      // DENIED the entire query — making BOTH the Updates feed and the Public
      // Status tab empty for everyone. Exclusion is therefore enforced
      // CLIENT-SIDE (status.js filters excludedUids for both useStatuses and
      // usePublicStatuses), matching the app's existing client-enforced
      // trust model for other limits. Do not reintroduce an unconstrained
      // field reference into this allow condition.
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
        || adminCanAccessStatus()
        || resource.data.visibility == 'public'
        || request.auth.uid in resource.data.allowedUids
      );
      allow create: if isSignedIn() && notBanned() && statusAllowed() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'subscriberCount'])
      );
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || adminCanAccessStatus());

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        // Comment authors may edit/delete their own comment. Any signed-in user
        // may update ONLY the vote arrays (up/down) of a comment they do not own
        // — this is how status-comment upvotes persist without each voter needing
        // write access to the author's comment document. We restrict the write to
        // just those two fields so the comment body/author cannot be altered.
        allow update: if isSignedIn() && (
          resource.data.uid == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['up', 'down'])
        );
        allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      }

      match /views/{viewerUid} {
        // Any signed-in user can record that they viewed a status (idempotent).
        allow create: if isSignedIn() && request.auth.uid == viewerUid;
        allow update: if isSignedIn() && request.auth.uid == viewerUid;
        allow read: if isSignedIn(); // owner checks who viewed; viewer checks own view
      }

      // Per-status subscriber list. Only the subscriber themselves, the status
      // owner, or an authorized admin (when admin status access is enabled) may
      // read it. Ordinary users cannot enumerate another user's subscribers.
      // Write (subscribe/unsubscribe) is restricted to the subscriber's own uid.
      match /subscribers/{subUid} {
        allow read: if isSignedIn() && (
          subUid == request.auth.uid
          || get(/databases/$(database)/documents/status/$(statusId)).data.ownerId == request.auth.uid
          || adminCanAccessStatus()
        );
        allow write: if isSignedIn() && request.auth.uid == subUid
          && request.resource.data.uid == request.auth.uid;
      }
    }

    // ── reports & feedback (write-only for regular users) ───
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reportedByUid == request.auth.uid;
      allow read, update: if isAdmin();
    }
    // Per-song flagging/reports (Apple Music moderation). Any signed-in user may
    // file a report; only admins can read/update/delete the queue.
    match /songReports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reportedByUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    // Admin new-signup notifications (Batch 4 item C). The creating user may write
    // only their own signup record; only admins may read the queue.
    match /notifications/{id} {
      allow create: if isSignedIn() &&
        request.resource.data.type == 'signup' &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── system messages (admin-only write, everyone reads) ──
    match /systemMessages/{messageId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── broadcast lists (owner-only) ────────────────────────
    match /broadcastLists/{listId} {
      allow read, write: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    // ── global config (admin write, everyone reads to apply limits) ──
    match /config/{doc} {
      // Public read: globalSettings carries no secrets (only limits/flags) and
      // must be readable even before sign-in so the login screen can honor
      // admin flags like hideDownloadCount.
      allow read: if true;
      // Bootstrap exception: any signed-in user can CREATE this doc only if
      // it doesn't already exist yet (first app load ensures sane defaults
      // exist) -- once created, only an admin can change it.
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/config/$(doc));
      allow update, delete: if isAdmin();
    }

    // ── pre-warm config (system_config/settings) ──
    // Same access model as config/{doc}: any signed-in user can read it
    // (it only carries preWarmEnabled); only admins can change it. Without
    // this rule the doc is denied by default, producing a 403 every launch.
    match /system_config/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/system_config/$(doc));
      allow update, delete: if isAdmin();
    }

    // ── AI access requests (user creates own, admin reads/writes all) ──
    match /aiRequests/{docId} {
      allow create: if isSignedIn();
      allow read, write, delete: if isAdmin();
    }

    // ── Group AI injection requests: a group admin asks the NexText admin to
    // inject NexText AI into their group. The group admin (who owns the chat
    // being requested) can create/read/cancel; the NexText admin approves or
    // rejects (which is what actually injects/evicts the AI). ──
    match /aiGroupRequests/{chatId} {
      allow read: if isAdmin() || (isSignedIn() && isGroupAdmin(chatId));
      allow create: if isSignedIn() && isGroupAdmin(chatId) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.chatId == chatId;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && isGroupAdmin(chatId));
    }

    // ── Calls (WebRTC signaling) — participants, caller, or callee may read; only participants may update
    match /calls/{callId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.callerUid ||
        request.auth.uid == resource.data.calleeUid ||
        request.auth.uid in resource.data.participants
      );
      allow create: if isSignedIn() && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.participants.hasAll([request.resource.data.callerUid, request.resource.data.calleeUid])
        && request.resource.data.state in ['calling', 'ringing'];
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.callerUid ||
        request.auth.uid == resource.data.calleeUid ||
        request.auth.uid in resource.data.participants
      );
      allow delete: if isAdmin();
      match /candidates/{candidateId} {
        allow read: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid ||
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants
        );
        allow create: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid ||
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants
        ) && request.resource.data.fromUid == request.auth.uid;
        allow delete: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid ||
          request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid ||
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participants
        );
      }
    }

    // ── Jewish Status analytics ──
    // Per-status aggregated clicks: any signed-in user may increment; admins may read all.
    match /jewishStatusClicks/{statusId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }
    // Per-user aggregated stats: owner may write own doc, anyone signed-in may read? Only admin needs full read - but user should read own.
    match /jewishUserStats/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if isAdmin();
    }

    // ── AI injected in groups: allow the AI system UID to write messages
    // into any group chat it has been added to as a participant ──
    // (The existing chats/{chatId}/messages create rule already allows
    //  senderId == 'nextext-ai-system'. Group chats are handled by the
    //  normal participant check since AI gets added as a participant
    //  via the Admin Dashboard Group Control Panel.)
  }
}
